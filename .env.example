# Copy to .env and fill in your own values. All are optional —
# the API degrades gracefully without them (see providers.py failover
# and README for details).

# Weather providers (Open-Meteo, the final fallback, needs no key)
OPENWEATHER_API_KEY=
WEATHERAPI_KEY=

# Redis connection — either set REDIS_URL directly, or just REDIS_HOST
# and it'll be built as redis://{REDIS_HOST}:6379/0
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
